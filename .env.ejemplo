# Credenciales de la API de Kame ERP
# Encuéntralas en Kame → Datos de empresa → Cliente ID / Cliente Secret
KAME_CLIENT_ID=pega_aqui_tu_client_id
KAME_CLIENT_SECRET=pega_aqui_tu_client_secret

# Correo del usuario Kame que registra/cierra órdenes de compra
KAME_USUARIO=correo_usuario_kame@dominio.cl

# Login web de Kame (solo para listar órdenes de compra; la API no lo permite)
KAME_WEB_EMAIL=tu_correo_de_login_kame
KAME_WEB_CLAVE=tu_clave_de_kame

# Opcionales
KAME_BODEGA_DEFAULT=Bismarck
KAME_UNIDAD_NEGOCIO_DEFAULT=Casa Matriz

# NUNCA subas este archivo con datos reales a GitHub (el repo es público).
